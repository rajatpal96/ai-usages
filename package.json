{
  "name": "agentmeter",
  "version": "1.0.0",
  "description": "AI Agent Usage & Observability Platform across Claude Code, Copilot, Gemini/Antigravity, Codex & Grok",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "agentpulse": "./apps/cli/bin/agentpulse.js",
    "agentmeter": "./apps/cli/bin/agentpulse.js"
  },
  "scripts": {
    "cli": "node apps/cli/bin/agentpulse.js",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "dashboard": "npm run dev --prefix apps/dashboard",
    "mcp": "tsx src/index.ts --mcp",
    "seed": "tsx packages/database/src/seed.ts",
    "test": "tsx src/scripts/testSuite.ts",
    "test:metrics": "tsx src/scripts/testSuite.ts",
    "simulate": "tsx src/scripts/simulate.ts",
    "build": "tsc",
    "deploy": "./scripts/deploy.sh",
    "deploy:quick": "./scripts/deploy.sh --skip-tests"
  },
  "keywords": [
    "agentmeter",
    "ai-observability",
    "mcp",
    "mcp-server",
    "claude-code",
    "copilot",
    "gemini",
    "antigravity",
    "codex",
    "grok"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "better-sqlite3": "^9.6.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.31.0",
    "mongoose": "^8.3.0",
    "next": "^16.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "mongodb-memory-server": "^9.1.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.3"
  }
}
